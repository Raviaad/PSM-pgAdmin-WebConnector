<?xml version="1.0" encoding="utf-8"?>
<!--
  CyberArk PSM Connection Component for pgAdmin 4
  Type:           Desktop application (installed pgAdmin4.exe)
  Authentication: Local form-based (pgAdmin email + password)
  pgAdmin version: 4.x (installed on Windows)

  IMPORTANT: This connector launches pgAdmin4.exe directly.
  pgAdmin installed app runs its own internal web server and opens
  in a bundled Chromium window - NOT Google Chrome.
  Protocol="Chrome" here is a PSM session type classifier only.

  How to import:
    1. Compress this file into a .zip named CC-pgAdmin4-web.zip
       (the zip name MUST start with CC-)
    2. Import via psPAS:
         Import-PASConnectionComponent .\CC-pgAdmin4-web.zip
    3. Assign this connection component to your PostgreSQL platform
    4. Ensure pgAdmin4-web_PSM.exe is compiled and placed in:
         C:\Program Files (x86)\CyberArk\PSM\Components\
    5. Add the exe to AppLocker:
         <Application Name="pgAdmin4-web_PSM" Type="Exe"
           Path="C:\Program Files (x86)\CyberArk\PSM\Components\pgAdmin4-web_PSM.exe"
           Method="Hash" />

  CyberArk Account Field Mapping:
    Username  = pgAdmin login email address (e.g. admin@admin.com)
    Password  = pgAdmin login password
    Address   = NOT required (pgAdmin4.exe is launched locally on the PSM)

  Notes:
    - Username field must contain the pgAdmin login EMAIL address
      e.g. admin@admin.com  (this is what pgAdmin local auth requires)
    - For local pgAdmin auth (not LDAP, not OAuth), ensure pgAdmin Server Mode
      is enabled. Disable the master password prompt in pgAdmin Preferences
      to prevent a secondary dialog blocking automated login.
    - Update $PGADMIN_EXE in the .au3 file to match your installed pgAdmin version path
      e.g. C:\Program Files\pgAdmin 4\v8\runtime\pgAdmin4.exe
-->
<ConnectionComponents>
  <ConnectionComponent
    Id="pgAdmin4-web"
    DisplayName="pgAdmin 4 - PostgreSQL Desktop"
    FullScreen="No"
    Height="900"
    Width="1440"
    EnableWindowScrollbar="No"
    EnableToolbars="No"
    Type="CyberArk.PasswordVault.TransparentConnection.PSM.PSMConnectionComponent, CyberArk.PasswordVault.TransparentConnection.PSM">

    <ComponentParameters />

    <UserParameters>
      <Parameter
        Name="AllowMappingLocalDrives"
        Type="CyberArk.TransparentConnection.BooleanUserParameter, CyberArk.PasswordVault.TransparentConnection"
        Value="No"
        Visible="Yes"
        Required="No"
        EnforceInDualControlRequest="No" />
    </UserParameters>

    <TargetSettings
      Protocol="Chrome"
      ClientApp="dummy.exe"
      ClientDispatcher="&quot;{PSMComponentsFolder}\pgAdmin4-web_PSM.exe&quot; &quot;{PSMComponentsFolder}&quot;"
      ClientInvokeType="Dispatcher"
      ConnectionComponentInitTimeout="90000">

      <ClientSpecific>
        <!-- Time (seconds) for each AutoIT action step to complete -->
        <Parameter Name="ActionTimeout" Value="15" />
        <!-- Time (seconds) to wait for pgAdmin to fully launch and render login form.
             Increase on slow machines. pgAdmin startup can take 20-60 seconds. -->
        <Parameter Name="PageLoadTimeout" Value="60" />
        <!-- Run built-in PSM validations -->
        <Parameter Name="RunValidations" Value="Yes" />
        <!-- Milliseconds to wait before hiding command-line parameters (credentials) -->
        <Parameter Name="WaitBeforeCmdlineParmsHide" Value="20000" />
        <!-- Milliseconds timeout for hiding command-line parameters -->
        <Parameter Name="CmdLineParmsHideTimeout" Value="30000" />
        <!-- Enable detailed trace logging for troubleshooting -->
        <Parameter Name="EnableTrace" Value="Yes" />
      </ClientSpecific>

      <!-- LockAppWindow: set Enable="Yes" and update MainWindowClass to the
           pgAdmin4.exe window class if you want strict window locking.
           Leave Enable="No" during initial testing. -->
      <LockAppWindow
        Enable="No"
        MainWindowClass="Chrome_WidgetWin_1"
        Timeout="800000"
        SearchWindowWaitTimeout="30" />

      <Capabilities>
        <!-- Record Windows UI events -->
        <Capability Id="WindowsEventsAudit" />
        <Capability Id="WindowsEventsTextRecorder" />
        <!-- Record keystrokes (captures SQL queries and typed input) -->
        <Capability Id="KeystrokesAudit" />
        <Capability Id="KeystrokesTextRecorder" />
      </Capabilities>

    </TargetSettings>
  </ConnectionComponent>
</ConnectionComponents>
